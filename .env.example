# All optional — the app works with zero configuration.
#
# Monitor-specific UptimeRobot API key (safe to expose: read-only, single
# monitor). Defaults to the key baked into src/api/uptimerobot.ts.
# VITE_UPTIMEROBOT_API_KEY=m000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override the API endpoint (e.g. point at your own proxy instead of calling
# UptimeRobot directly).
# VITE_API_ENDPOINT=https://api.uptimerobot.com/v2/getMonitors

# Comma-separated monitor IDs to display. Leave empty to show all monitors
# the key can access.
# VITE_MONITOR_IDS=

# Set to "true" to render generated sample data instead of live API calls.
# VITE_USE_MOCK=true

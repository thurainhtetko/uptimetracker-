{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=45, stale-while-revalidate=30"
        }
      ]
    }
  ]
}

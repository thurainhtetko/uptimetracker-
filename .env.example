# These values are compiled into the client bundle by Vite and are visible to
# anyone who visits the site. Use a read-only or monitor-specific key, and
# rotate it if it has ever been committed to git.
VITE_UPTIMEROBOT_API_KEY=

# Optional: comma-separated monitor IDs to include. Leave empty to show every
# monitor the key can access.
VITE_UPTIMEROBOT_MONITOR_IDS=

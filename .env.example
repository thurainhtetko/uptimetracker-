# Server-side only (never VITE_ prefixed — never sent to the browser).
# UptimeRobot v2 account-specific or read-only API key.
UPTIMEROBOT_API_KEY=your_api_key_here

# Comma-separated monitor IDs to display. Leave empty to show all monitors.
VITE_MONITOR_IDS=

# Set to "true" to render generated sample data instead of live API calls.
VITE_USE_MOCK=false

# Optional: override the API endpoint (e.g. a deployed proxy). Defaults to the
# Vite dev proxy at /api/uptimerobot. For production, point this at an
# equivalent server-side proxy so the API key is never exposed to clients.
# VITE_API_ENDPOINT=/api/uptimerobot

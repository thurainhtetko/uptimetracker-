# Server-side only. Create a read-only or monitor-specific UptimeRobot key.
# This value is read by /api/status (and the Vite dev middleware) and must
# never be exposed to the browser. Do not prefix it with VITE_.
UPTIMEROBOT_API_KEY=

# Optional: comma-separated monitor IDs to include. Leave empty to show all
# monitors the key can access.
UPTIMEROBOT_MONITOR_IDS=

# Optional: override the UptimeRobot endpoint (useful for testing).
# UPTIMEROBOT_API_ENDPOINT=https://api.uptimerobot.com/v2/getMonitors
